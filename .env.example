# Copy this file to .env and adjust as needed. .env is gitignored — never commit it.

# Local SQLite database file (path relative to repo root).
DATABASE_URL="file:./dev.db"

# Required from Phase 10 onward (agent orchestration/explanation). The report
# specifies Claude for this layer; the prototype uses Gemini instead — an
# explicit deviation, see docs/PROTOTYPE_IMPLEMENTATION_PLAN.md Phase 10.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
